rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function teacher() {
      return signedIn() && (
        request.auth.token.role == 'teacher' ||
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true
      );
    }

    function admin() {
      return signedIn() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true
      );
    }

    function ownStudent(studentId) {
      return signedIn() && (
        request.auth.uid == studentId ||
        request.auth.token.student_id == studentId
      );
    }

    // Student records. Never expose credentials or allow students to change roles.
    match /students/{studentId} {
      allow read: if teacher() || ownStudent(studentId);
      allow create: if teacher();
      allow update: if teacher() || (
        ownStudent(studentId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'is_admin', 'username', 'password', 'password_hash',
          'payment_status', 'payment_amount'
        ])
      );
      allow delete: if admin();
    }

    // Practice telemetry. Student writes must be bound to the authenticated UID.
    match /practice_logs/{logId} {
      allow read: if teacher() || (signedIn() && resource.data.student_uid == request.auth.uid);
      allow create: if teacher() || (
        signedIn() && request.resource.data.student_uid == request.auth.uid
      );
      allow update, delete: if teacher();
    }

    match /assignments/{assignmentId} {
      allow read: if signedIn();
      allow create, update, delete: if teacher();
    }

    match /homework/{homeworkId} {
      allow read: if signedIn();
      allow create, update, delete: if teacher();
    }

    match /homework_submissions/{submissionId} {
      allow read: if teacher() || (signedIn() && resource.data.student_uid == request.auth.uid);
      allow create: if teacher() || (signedIn() && request.resource.data.student_uid == request.auth.uid);
      allow update: if teacher() || (signedIn() && resource.data.student_uid == request.auth.uid);
      allow delete: if teacher();
    }

    match /payments/{paymentId} {
      allow read: if admin() || (signedIn() && resource.data.student_uid == request.auth.uid);
      allow create: if teacher() || (signedIn() && request.resource.data.student_uid == request.auth.uid);
      allow update, delete: if admin();
    }

    match /class_sessions/{sessionId} {
      allow read: if signedIn();
      allow write: if teacher();
    }

    // Backward-compatible name used by older deployments.
    match /zoom_sessions/{sessionId} {
      allow read: if signedIn();
      allow write: if teacher();
    }

    match /student_groups/{groupId} {
      allow read: if signedIn();
      allow write: if teacher();
    }

    match /curriculum_permissions/{permissionId} {
      allow read: if teacher() || (signedIn() && resource.data.student_uid == request.auth.uid);
      allow write: if teacher();
    }

    match /curriculum/{docId} {
      allow read: if signedIn();
      allow write: if teacher();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
